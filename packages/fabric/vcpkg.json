{
  "dependencies": [
    {
      "name": "opencl",
      "platform": "android"
    },
    {
      "name": "qvac-fabric",
      "version>=": "11259.0.0",
      "features": [
        {
          "name": "cuda-backend",
          "platform": "linux | (windows & x64)"
        },
        "hip-backend",
        {
          "name": "rpc-rdma",
          "platform": "linux"
        },
        "vector-index"
      ]
    },
    {
      "name": "qvac-lint-cpp",
      "version>=": "1.4.5"
    }
  ],
  "features": {
    "hexagon": {
      "description": "Build the Android arm64 Hexagon backend and DSP sidecars",
      "dependencies": [
        {
          "name": "qvac-fabric",
          "platform": "android & arm64",
          "features": [
            "hexagon-backend"
          ]
        }
      ]
    },
    "cuda-jetson": {
      "description": "Build the CUDA 12 Jetson backend module",
      "dependencies": [
        {
          "name": "qvac-fabric",
          "platform": "linux & arm64",
          "features": [
            "cuda-jetson-backend"
          ]
        }
      ]
    },
    "vk-profiling": {
      "description": "Force vk performance logging in qvac-fabric",
      "dependencies": [
        {
          "name": "qvac-fabric",
          "features": [
            "force-profiler"
          ]
        }
      ]
    }
  }
}
